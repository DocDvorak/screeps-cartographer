{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig.json to read more about this file */
    /* Basic Options */
    "target": "es2024",
    "module": "ESNext",
    "lib": [
      "es2024"
    ],
    "allowJs": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "paths": {
      "*": [
        "./src/*"
      ],
    },
    "rootDir": "src",
    "types": [
      "jest",
      "screeps"
    ],
    /* Strict Type-Checking Options */
    "strict": true,
    /* Module Resolution Options */
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    /* Advanced Options */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/test.ts",
    "src/tests"
  ]
}